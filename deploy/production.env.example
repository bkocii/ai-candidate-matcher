# Store the real file outside the repository, for example:
# /etc/ai-candidate-matcher.env with mode 0600.
DJANGO_ENVIRONMENT=production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=matcher.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://matcher.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_STATIC_ROOT=/srv/ai-candidate-matcher/current/staticfiles
DJANGO_MEDIA_ROOT=/srv/ai-candidate-matcher/private-media

POSTGRES_DB=ai_candidate_matcher
POSTGRES_USER=ai_candidate_matcher
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=prefer

AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_RETRIES=1
OPENAI_API_KEY=replace-with-the-provider-key
