[Unit]
Description=AI Candidate Matcher web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-candidate-matcher
Group=www-data
WorkingDirectory=/srv/ai-candidate-matcher/current
EnvironmentFile=/etc/ai-candidate-matcher.env
RuntimeDirectory=ai-candidate-matcher
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/srv/ai-candidate-matcher/current/.venv/bin/gunicorn config.wsgi:application --bind unix:/run/ai-candidate-matcher/gunicorn.sock --workers 3 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
